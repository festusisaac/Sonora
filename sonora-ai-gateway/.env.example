# SONORA AI Gateway Environment Configuration
# NEVER commit the real .env file with actual credentials to version control!

PORT=3001
HOST=0.0.0.0

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_REQUEST_TIMEOUT=15000
GEMINI_MAX_OUTPUT_TOKENS=1024

# Gateway Authentication & Rate Limiting
GATEWAY_AUTH_TOKEN=sonora_dev_secret_auth_token_replace_in_prod
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ElevenLabs High-Fidelity Voice Synthesis (Free tier: 10k chars/month)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
